<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12+. Never back up or transfer the model; it can be re-downloaded. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
